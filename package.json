{
  "name": "teams-readonly-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server over your own Microsoft Teams chats. No write tools, read-only OAuth scopes, GET-only.",
  "type": "module",
  "bin": {
    "teams-readonly-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "html-to-text": "^10.0.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tayam-El-Jebari/teams-readonly-mcp.git"
  },
  "keywords": [
    "mcp",
    "microsoft-teams",
    "microsoft-graph",
    "read-only",
    "claude"
  ]
}
